{
  "manifest_version": 3,
  "name": "SecureFlow AI - DLP Browser Agent",
  "version": "2.0.0",
  "description": "Enterprise Real-Time Data Leakage Prevention (DLP) across all forms, emails, and web applications.",
  "permissions": [
    "storage",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:9090/*",
    "http://127.0.0.1:9090/*",
    "http://localhost:5174/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SecureFlow AI DLP Guardian",
    "default_icon": "icon128.png"
  }
}
